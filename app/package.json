  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "engine:build": "node engine/build.mjs",
    "engine:verify": "tsx --env-file=../tools/test-server/.env harness/verify.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "sqlfn:build": "sh modules/accrual-sqlite-functions/build-host.sh",
