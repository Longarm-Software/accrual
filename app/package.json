    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/modules/",
      "<rootDir>/harness/",
      "<rootDir>/engine/"
    ]
  }
