#!/bin/sh
# Block commits that contain secrets (tokens, keys, passwords).
# Enable once per clone:  git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Commit blocked." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --verbose || {
  echo "" >&2
  echo "pre-commit: gitleaks found a possible secret. Remove it and commit again." >&2
  echo "If it's a false positive, add an allowlist entry to .gitleaks.toml (never --no-verify)." >&2
  exit 1
}
